# The eIF depletion experiments in config/samples.csv: the Ribo-seq aligned by
# wf-riboseq-align, imported once for all of them (rules/align.smk), the
# RNA-seq quantified and the expression filter (rules/rnaseq.smk), with the
# RNA-seq library correction (rules/rna_correction.smk), the Ribo-seq
# quantification (rules/ribokit.smk) and its QC panel (rules/rpf_qc.smk), the
# deltaTE model (rules/deltate.smk) and the master table (rules/master.smk).

import os
import re

import pandas as pd

configfile: "config/config.yaml"

RESULTS_DIR = config.get("RESULTS_DIR", "results")
LOG_DIR = config.get("LOG_DIR", "logs")

SAMPLES = pd.read_csv(config["samples"], dtype=str, keep_default_na=False).set_index("sample_id", drop=False)
RIBO_SAMPLES = list(SAMPLES.loc[SAMPLES["read_type"] == "ribo", "sample_id"])
RNA_SAMPLES = list(SAMPLES.loc[SAMPLES["read_type"] == "rna", "sample_id"])

# The experiments run: samples.csv's `experiment` column, for the samples at
# config timepoints. Adding one takes only its rows there.
if not set(config["timepoints"]) <= set(SAMPLES["timepoint"]):
    raise ValueError(f"config timepoints: {config['timepoints']}, samples.csv has {sorted(set(SAMPLES['timepoint']))}")
EXPERIMENT_NAMES = sorted(set(SAMPLES.loc[SAMPLES["timepoint"].isin(config["timepoints"]), "experiment"]))
# the {exp} wildcard's constraint
EXPERIMENT_RE = "|".join(map(re.escape, EXPERIMENT_NAMES))


def samples_of(exp, read_type):
    """An experiment's ribo or rna sample ids, in samples.csv's order."""
    return list(SAMPLES.loc[(SAMPLES["experiment"] == exp) & (SAMPLES["read_type"] == read_type), "sample_id"])


# the experiments run with RNA-seq; the others (Ribo-seq only) get no RNA-seq
# outputs, and ribokit counts them on the whole collapsed GTF
RNA_EXPERIMENTS = [exp for exp in EXPERIMENT_NAMES if samples_of(exp, "rna")]


# align.smk's per-experiment outputs: split BAMs, qc
ALIGN_DIR = f"{RESULTS_DIR}/align/{{exp}}"


include: "rules/collapse_transcriptome.smk"
include: "rules/align.smk"
include: "rules/rnaseq.smk"
include: "rules/rna_correction.smk"
include: "rules/ribokit.smk"
include: "rules/rpf_qc.smk"
include: "rules/deltate.smk"
include: "rules/master.smk"


rule all:
    default_target: True
    input:
        # everything wf-riboseq-align's own `rule all` builds, not only what
        # the steps below read: incl. qc/summary.tsv, whose rule fails an
        # experiment whose spike-in fraction is below min_spike_in_fraction;
        # for the experiments run only (not the other timepoints')
        [f for f in rules.align_all.input
         if os.path.relpath(f, f"{RESULTS_DIR}/align").split("/")[0] in EXPERIMENT_NAMES],
        # the RNA-seq QC (salmon, FastQC)
        [f"{RNASEQ_DIR}/{exp}/multiqc/multiqc_report.html" for exp in RNA_EXPERIMENTS],
        # the human Ribo-seq BAMs minus the RNA-seq blacklist, for tools other than this workflow's
        [RNASEQ_RIBO_BAM.format(exp=exp, sample=s) for exp in RNA_EXPERIMENTS for s in samples_of(exp, "ribo")],
        # the corrected RNA-seq quantifications + what the correction did
        [f"{RNA_CORRECTION_DIR}/{exp}/factors.tsv" for exp in RNA_EXPERIMENTS],
        # the Ribo-seq quantifications
        [f"{RIBOKIT_DIR}/{exp}/{s}.{species}.quant.tsv"
         for exp in EXPERIMENT_NAMES for s in samples_of(exp, "ribo") for species in ("human", "yeast")],
        # the Ribo-seq QC panel per experiment
        [f"{RPF_QC_DIR}/{exp}/{exp}_rpf_qc.pdf" for exp in EXPERIMENT_NAMES],
        # the deltaTE model + DESeq2 per assay: the experiments with both
        # conditions in both assays only (deltate.smk)
        [f"{DELTATE_DIR}/{exp}/deseq_res_{kind}.tsv"
         for exp in DELTATE_EXPERIMENTS
         for kind in ("deltaTE_yeastnorm", "deltaTE_autonorm", "diffribo_yeastnorm", "diffribo_autonorm",
                      "difftotal_autonorm")],
        # the master tables, yeastnorm and autonorm, full and filtered (if any experiment has deltaTE)
        [f"{RESULTS_DIR}/master/eif-master.{norm}{f}.csv" for norm in MASTER_NORMS for f in ("", ".filtered")]
        if DELTATE_EXPERIMENTS else [],
